# Sliver MCP Server Configuration
# Copy this file to .env and adjust values for your environment.

# Path to Sliver operator config (.cfg file with mTLS credentials)
# If unset, auto-detects first .cfg in ~/.sliver-client/configs/
SLIVER_CONFIG=~/.sliver-client/configs/operator.cfg

# Project root directory (auto-detected if unset)
# SLIVER_PROJECT_ROOT=/path/to/sliver-mcp

# Evasion scripts directory (default: $PROJECT_ROOT/evasion)
# SLIVER_EVASION_DIR=/path/to/evasion

# Evidence collection output directory
SLIVER_EVIDENCE_DIR=/tmp/sliver-evidence

# Engagement state SQLite database path
# SLIVER_STATE_DB=/path/to/engagement_state.db

# OPSEC guard mode: warn (default), block, or silent
# - warn: execute with warning prefix when EDR detected
# - block: refuse execution when EDR detected
# - silent: skip OPSEC checks entirely
SLIVER_OPSEC_MODE=warn

# Encryption key for credential at-rest encryption (Fernet)
# If unset, credentials are stored in plaintext (not recommended for production)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SLIVER_STATE_KEY=

# Maximum hosts for network sweep playbook (default: 256)
# SLIVER_SWEEP_MAX_HOSTS=256
